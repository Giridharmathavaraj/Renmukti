{
  "hosting": {
    "public": "dist",
    "rewrites": [
      {
        "source": "/api/**",
        "destination": "/server/phase1/api/**"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "slate": {
    "apps": [
      {
        "name": "renmukti-app",
        "framework": "react",
        "install_command": "npm install",
        "build_command": "npm run build",
        "build_path": "dist"
      }
    ]
  }
}
